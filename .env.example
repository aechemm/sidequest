# Crusoe Managed Inference
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1/
CRUSOE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Neo4j Aura
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Plaud Embedded (transcription)
PLAUD_CLIENT_ID=
PLAUD_API_KEY=

# Plaud account sync (sign in via: npm run plaud:login)
# PLAUD_AUTO_SYNC=0 to disable
PLAUD_AUTO_SYNC=1
PLAUD_SYNC_INTERVAL_MS=900000

# BAND (optional)
BAND_SCOUT_ID=
BAND_SCOUT_KEY=
BAND_GRAPH_AGENT_ID=
BAND_GRAPH_AGENT_KEY=
BAND_CONNECTOR_ID=
BAND_CONNECTOR_KEY=
BAND_CRITIC_ID=
BAND_CRITIC_KEY=
BAND_CHAT_ID=
BAND_ROOM_URL=
