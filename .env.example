# Local laptop tip: leave CRUSOE_API_KEY empty for instant mock demo.
# Demo Data uses mock mode by default — no keys required.

# Crusoe Managed Inference
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1/
CRUSOE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Neo4j Aura — choose "Build a graph-powered application"
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Plaud Embedded
PLAUD_CLIENT_ID=
PLAUD_API_KEY=

# Plaud account auto-sync (CLI must be logged in via npm run plaud:login)
# PLAUD_AUTO_SYNC=0 to disable
# PLAUD_SYNC_INTERVAL_MS=900000  # 15 minutes (default)
PLAUD_AUTO_SYNC=1
PLAUD_SYNC_INTERVAL_MS=900000

# BAND — Scout, GraphAgent, Connector, Critic
BAND_SCOUT_ID=
BAND_SCOUT_KEY=
BAND_GRAPH_AGENT_ID=
BAND_GRAPH_AGENT_KEY=
BAND_CONNECTOR_ID=
BAND_CONNECTOR_KEY=
BAND_CRITIC_ID=
BAND_CRITIC_KEY=
BAND_CHAT_ID=
BAND_ROOM_URL=https://app.band.ai/chats/your-room-id
